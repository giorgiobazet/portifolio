---
// Capa de um projeto: print do site, trecho de código ou ilustração de blocos.
interface Props {
  capa: { tipo: string; src?: string; arquivo?: string; trecho?: string };
  titulo: string;
  grande?: boolean;
  /** Carregar já (projeto em destaque / topo da página). */
  prioridade?: boolean;
}
const { capa, titulo, grande = false, prioridade = false } = Astro.props;

// Destaque de sintaxe bem simples para o trecho de código.
const PALAVRAS = /\b(typedef|struct|int|char|float|switch|case|break|class|def|if|try|except|raise|pass|as|return)\b/g;
const escapar = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

function colorirTrecho(trecho: string) {
  // Separa strings literais do resto, para não colorir o que está dentro delas.
  return trecho
    .split(/("(?:[^"\\]|\\.)*")/g)
    .map((parte, i) =>
      i % 2 === 1
        ? `<span class="c-str">${escapar(parte)}</span>`
        : escapar(parte)
            .replace(PALAVRAS, '\u0001kw\u0002$1\u0003')
            .replace(/\b([A-Z][A-Za-z]+)\b/g, '\u0001tipo\u0002$1\u0003')
            .replace(/\b(\d+)\b/g, '\u0001num\u0002$1\u0003')
            .replace(/\u0001(\w+)\u0002/g, '<span class="c-$1">')
            .replace(/\u0003/g, '</span>'),
    )
    .join('');
}

function colorir(codigo: string) {
  return codigo
    .split('\n')
    .map((l, i) => `<span class="c-ln">${String(i + 1).padStart(2, ' ')}</span>${colorirTrecho(l)}`)
    .join('\n');
}
---

{
  capa.tipo === 'imagem' && (
    <img
      class="capa capa--imagem"
      src={`${capa.src}${grande ? '' : '-720'}.webp`}
      alt={titulo}
      width={grande ? 1440 : 720}
      height={grande ? 900 : 450}
      loading={prioridade ? 'eager' : 'lazy'}
      decoding="async"
    />
  )
}

{
  capa.tipo === 'codigo' && (
    <div class:list={['capa capa--codigo', { 'capa--grande': grande }]} role="img" aria-label={`${titulo}: ${capa.arquivo}`}>
      <div class="capa__aba mono">
        <span class="capa__ponto" />
        {capa.arquivo}
      </div>
      <pre class="mono" set:html={colorir(capa.trecho ?? '')} />
    </div>
  )
}

{
  capa.tipo === 'blocos' && (
    <div class:list={['capa capa--blocos', { 'capa--grande': grande }]} role="img" aria-label={titulo}>
      <div class="bloco bloco--evento">quando ▶ for clicado</div>
      <div class="bloco bloco--laco">
        repita <b>4</b> vezes
        <div class="bloco bloco--acao">mover <b>10</b> passos</div>
        <div class="bloco bloco--se">
          se <i>tocando parede?</i> então
          <div class="bloco bloco--acao">girar ↻ <b>90</b>°</div>
        </div>
      </div>
      <div class="bloco bloco--var">mudar <i>pontos</i> para <b>pontos + 1</b></div>
    </div>
  )
}

<style>
  .capa { width: 100%; height: auto; aspect-ratio: 16 / 10; display: block; }
  .capa--imagem { object-fit: cover; object-position: top; background: var(--superficie); }

  .capa--codigo {
    background: linear-gradient(160deg, #0c1017, #040609);
    padding: 0 0 12px;
    overflow: hidden;
  }
  .capa__aba {
    display: flex;
    align-items: center;
    gap: 8px;
    width: max-content;
    padding: 9px 16px;
    font-size: 0.72rem;
    color: var(--texto-2);
    background: var(--superficie-2);
    border-right: 1px solid var(--linha);
    border-top: 2px solid var(--acento);
  }
  /* Na página do projeto, o código e os blocos ocupam só a altura que precisam. */
  .capa--grande { aspect-ratio: auto; }
  .capa--codigo.capa--grande { padding-bottom: 24px; }
  .capa--codigo.capa--grande pre { font-size: clamp(0.72rem, 1.5vw, 0.92rem); padding: 20px 24px 0; overflow-x: auto; }
  .capa--blocos.capa--grande { padding: 40px; font-size: clamp(0.72rem, 1.5vw, 0.95rem); }
  .capa__ponto { width: 7px; height: 7px; border-radius: 50%; background: var(--acento-2); }
  .capa--codigo pre {
    margin: 0;
    padding: 14px 16px 0;
    font-size: clamp(0.62rem, 1.4vw, 0.74rem);
    line-height: 1.7;
    color: #c9d6e6;
    white-space: pre;
  }
  .capa--codigo :global(.c-ln) { color: #3b4c66; margin-right: 14px; user-select: none; }
  .capa--codigo :global(.c-kw) { color: var(--acento); }
  .capa--codigo :global(.c-str) { color: var(--acento-2); }
  .capa--codigo :global(.c-tipo) { color: #9fb7ff; }
  .capa--codigo :global(.c-num) { color: #f0a77f; }

  .capa--blocos {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 6px;
    padding: 18px 22px;
    background:
      radial-gradient(circle at 80% 20%, rgba(62, 230, 255, 0.12), transparent 50%),
      linear-gradient(160deg, #0c1017, #040609);
    font-size: clamp(0.62rem, 1.4vw, 0.78rem);
    font-weight: 600;
    overflow: hidden;
  }
  .bloco {
    padding: 6px 12px;
    border-radius: 8px;
    color: #fff;
    width: max-content;
    max-width: 100%;
    box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.25);
  }
  .bloco b, .bloco i {
    display: inline-block;
    padding: 0 8px;
    margin: 0 2px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: #1b2433;
    font-style: normal;
  }
  .bloco--evento { background: #c9a24f; border-radius: 14px 14px 8px 8px; }
  .bloco--laco { background: #1fa89a; padding-bottom: 10px; }
  .bloco--se { background: #3b82c4; margin-top: 6px; padding-bottom: 10px; }
  .bloco--acao { background: #4b5fc9; margin: 6px 0 0 14px; }
  .bloco--var { background: #c76a3b; }
</style>
