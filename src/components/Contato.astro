---
import Icone from './Icone.astro';
import { textos, contato, type Idioma } from '../i18n/textos';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const t = textos[lang].contato;
---

<section class="secao contato" id="contato" aria-labelledby="contato-titulo">
  <div class="container">
    <div class="contato__caixa hud hud--ativo" data-revelar>
      <p class="secao__numero">[{t.numero}] <span>// {lang === 'pt' ? 'CONTATO' : 'CONTACT'}</span></p>
      <h2 class="contato__titulo" id="contato-titulo">{t.titulo1} <span class="realce">{t.titulo2}</span></h2>
      <p class="contato__texto">{t.texto}</p>

      <div class="contato__email">
        <a class="mono" href={`mailto:${contato.email}`}>{contato.email}</a>
        <button class="btn btn--pequeno" type="button" data-copiar={contato.email} data-copiado={t.copiado}>
          <Icone nome="copiar" />
          <span>{t.copiar}</span>
        </button>
      </div>

      <div class="contato__redes">
        <a class="btn btn--primario" href={`mailto:${contato.email}`}><Icone nome="email" /> E-mail</a>
        <a class="btn" href={contato.linkedin} target="_blank" rel="noopener noreferrer"><Icone nome="linkedin" /> LinkedIn</a>
        <a class="btn" href={contato.github} target="_blank" rel="noopener noreferrer"><Icone nome="github" /> GitHub</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contato__caixa {
    --corte: 28px;
    --fundo-hud:
      radial-gradient(600px 260px at 50% 0%, rgba(198, 255, 61, 0.1), transparent 70%),
      linear-gradient(180deg, rgba(18, 24, 36, 0.92), rgba(8, 11, 16, 0.92));
    padding: clamp(36px, 7vw, 84px) clamp(20px, 5vw, 64px);
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 20px;
  }
  .contato__titulo { font-size: clamp(2rem, 5.6vw, 3.8rem); max-width: 18ch; letter-spacing: -0.045em; }
  .contato__texto { color: var(--texto-2); max-width: 46ch; }
  .contato__email {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px;
    padding: 10px 10px 10px 20px;
    border: 1px solid var(--linha-forte);
    background: rgba(4, 6, 9, 0.6);
    max-width: 100%;
  }
  .contato__email a { font-size: clamp(0.85rem, 2.4vw, 1.05rem); color: var(--texto); word-break: break-all; }
  .contato__email a:hover { color: var(--acento); }
  .contato__redes { margin-top: 12px; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((botao) => {
    const rotulo = botao.querySelector('span')!;
    const original = rotulo.textContent;
    botao.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(botao.dataset.copiar!);
        rotulo.textContent = botao.dataset.copiado!;
        botao.classList.add('btn--primario');
        setTimeout(() => {
          rotulo.textContent = original;
          botao.classList.remove('btn--primario');
        }, 2000);
      } catch {
        window.location.href = `mailto:${botao.dataset.copiar}`;
      }
    });
  });
</script>
