---
import Icone from './Icone.astro';
import { textos, type Idioma } from '../i18n/textos';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const t = textos[lang];
const nome = 'GIORGIO BAZET';
---

<div class="intro" id="intro" role="dialog" aria-modal="true" aria-label="Intro">
  <button class="intro__pular" type="button" data-entrar>{t.intro.pular} <kbd>Esc</kbd></button>

  <div class="intro__centro">
    <ol class="intro__boot mono" aria-hidden="true">
      {t.intro.linhas.map((l, i) => <li style={`--i:${i}`}><span>›</span> {l}</li>)}
    </ol>

    <div class="intro__marca">
      <p class="intro__selo mono">GB · {lang === 'pt' ? 'PORTFÓLIO' : 'PORTFOLIO'}</p>
      <h2 class="intro__nome" aria-label="Giorgio Bazet">
        {[...nome].map((c, i) => <span style={`--i:${i}`} aria-hidden="true">{c === ' ' ? ' ' : c}</span>)}
      </h2>
      <p class="intro__papel">{t.intro.papel}</p>
      <button class="intro__entrar" type="button" data-entrar>
        <Icone nome="play" tamanho={18} />
        {t.intro.entrar}
      </button>
    </div>
  </div>

  <div class="intro__varredura" aria-hidden="true"></div>
</div>

<style>
  .intro { display: none; }
  :global(html[data-intro='on']) .intro {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    background:
      radial-gradient(800px 500px at 50% 45%, rgba(198, 255, 61, 0.08), transparent 70%),
      #020305;
    overflow: hidden;
  }
  .intro.saindo { animation: sair 0.9s var(--ease) forwards; }
  @keyframes sair {
    to { opacity: 0; transform: scale(1.06); filter: blur(6px); visibility: hidden; }
  }

  .intro__pular {
    position: absolute;
    top: 20px;
    right: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-radius: 10px;
    border: 1px solid var(--linha);
    background: rgba(12, 16, 23, 0.6);
    color: var(--texto-2);
    font-size: 0.85rem;
  }
  .intro__pular:hover { color: var(--texto); border-color: var(--linha-forte); }

  .intro__centro { width: min(760px, calc(100vw - 32px)); display: grid; gap: 48px; }

  .intro__boot { list-style: none; margin: 0; padding: 0; font-size: 0.82rem; color: var(--suave); display: grid; gap: 6px; }
  .intro__boot li {
    opacity: 0;
    animation: linha 0.35s var(--ease) forwards;
    animation-delay: calc(var(--i) * 280ms + 200ms);
    white-space: pre;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .intro__boot li span { color: var(--acento); }
  .intro__boot li:last-child { color: var(--acento); }
  @keyframes linha { from { opacity: 0; transform: translateX(-8px); } to { opacity: 1; transform: none; } }

  .intro__marca { display: grid; justify-items: center; text-align: center; gap: 18px; }
  .intro__selo {
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    color: var(--acento-2);
    opacity: 0;
    animation: aparecer 0.6s 1.7s var(--ease) forwards;
  }
  .intro__nome {
    font-size: clamp(2.4rem, 9vw, 6.2rem);
    letter-spacing: 0.04em;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }
  .intro__nome span {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.4em);
    filter: blur(8px);
    animation: letra 0.7s var(--ease) forwards;
    animation-delay: calc(1.8s + var(--i) * 45ms);
  }
  @keyframes letra { to { opacity: 1; transform: none; filter: none; } }
  .intro__papel {
    color: var(--texto-2);
    font-size: clamp(0.95rem, 2.4vw, 1.15rem);
    opacity: 0;
    animation: aparecer 0.7s 2.6s var(--ease) forwards;
  }
  .intro__entrar {
    margin-top: 16px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 30px;
    border-radius: 3px;
    border: 0;
    background: var(--acento);
    color: var(--sobre-acento);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.9rem;
    box-shadow: 0 0 0 0 rgba(198, 255, 61, 0.5);
    opacity: 0;
    animation: aparecer 0.6s 3s var(--ease) forwards, brilho 2.4s 3.6s infinite;
  }
  .intro__entrar:hover { background: var(--acento-forte); }
  @keyframes aparecer { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes brilho {
    0%, 100% { box-shadow: 0 0 0 0 rgba(198, 255, 61, 0.45); }
    50% { box-shadow: 0 0 0 14px rgba(198, 255, 61, 0); }
  }

  /* Linha de varredura que atravessa a tela uma vez */
  .intro__varredura {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, rgba(198, 255, 61, 0.07) 48%, rgba(198, 255, 61, 0.18) 50%, transparent 52%);
    background-size: 100% 220%;
    animation: varrer 2.2s 1.5s ease-in-out 1 both;
  }
  @keyframes varrer {
    from { background-position: 0 100%; opacity: 1; }
    90% { opacity: 1; }
    to { background-position: 0 -120%; opacity: 0; }
  }

  @media (max-width: 520px) {
    .intro__boot { font-size: 0.72rem; }
    .intro__nome { white-space: normal; }
  }
</style>

<script>
  const html = document.documentElement;
  const intro = document.getElementById('intro');

  if (intro && html.dataset.intro === 'on') {
    const entrar = intro.querySelector<HTMLButtonElement>('.intro__entrar');
    setTimeout(() => entrar?.focus({ preventScroll: true }), 3100);

    let saiu = false;
    const sair = () => {
      if (saiu) return;
      saiu = true;
      try {
        sessionStorage.setItem('intro-vista', '1');
      } catch {}
      intro.classList.add('saindo');
      intro.addEventListener('animationend', () => {
        html.removeAttribute('data-intro');
        intro.remove();
        document.getElementById('conteudo')?.focus({ preventScroll: true });
      }, { once: true });
    };

    intro.querySelectorAll('[data-entrar]').forEach((b) => b.addEventListener('click', sair));
    document.addEventListener('keydown', function tecla(e) {
      if (e.key === 'Escape' || (e.key === 'Enter' && document.activeElement === document.body)) {
        sair();
        document.removeEventListener('keydown', tecla);
      }
    });
  } else {
    intro?.remove();
  }
</script>
