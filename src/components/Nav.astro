---
import Icone from './Icone.astro';
import { textos, rotas, type Idioma } from '../i18n/textos';

interface Props {
  lang: Idioma;
  alternativo: string;
}
const { lang, alternativo } = Astro.props;
const t = textos[lang];
const home = rotas[lang].home;
const links = [
  { secao: 'projetos', num: '01', texto: t.nav.projetos },
  { secao: 'stack', num: '02', texto: t.nav.stack },
  { secao: 'sobre', num: '04', texto: t.nav.sobre },
  { secao: 'trajetoria', num: '05', texto: t.nav.trajetoria },
  { secao: 'contato', num: '06', texto: t.nav.contato },
];
---

<header class="nav" data-nav>
  <div class="container nav__dentro">
    <a class="marca" href={home} aria-label="Giorgio Bazet">
      <span class="marca__mono">G<b>B</b></span>
      <span class="marca__nome">Giorgio Bazet</span>
    </a>

    <nav class="nav__links" id="menu" aria-label={lang === 'pt' ? 'Principal' : 'Main'}>
      {
        links.map((l) => (
          <a href={`${home}#${l.secao}`} data-secao={l.secao}>
            <span>{l.num}</span>
            {l.texto}
          </a>
        ))
      }
      <i class="nav__indicador" aria-hidden="true" data-indicador></i>
    </nav>

    <div class="nav__acoes">
      <a class="nav__idioma" href={alternativo} hreflang={lang === 'pt' ? 'en' : 'pt-BR'} title={t.idiomaOutro.nome}>
        {t.idiomaOutro.rotulo}
      </a>
      <button class="btn btn--pequeno nav__terminal" type="button" data-abrir-terminal>
        <Icone nome="terminal" />
        <span>{t.nav.terminal}</span>
        <kbd>Ctrl K</kbd>
      </button>
      <button class="nav__menu" type="button" aria-controls="menu" aria-expanded="false" data-menu>
        <Icone nome="menu" tamanho={20} />
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>
  <div class="nav__progresso" aria-hidden="true"><i data-progresso></i></div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s;
    border-bottom: 1px solid transparent;
  }
  .nav.rolou {
    background: rgba(4, 6, 9, 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-color: var(--linha);
  }
  .nav__dentro {
    height: 72px;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .marca { display: flex; align-items: center; gap: 12px; margin-right: auto; }
  .marca__mono {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid rgba(198, 255, 61, 0.45);
    font-family: var(--fonte-mono);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .marca__mono b { color: var(--acento-2); font-weight: 500; }
  .marca__nome { font-family: var(--fonte-titulo); font-weight: 500; letter-spacing: -0.01em; }

  .nav__links { position: relative; display: flex; gap: 6px; }
  .nav__links a {
    position: relative;
    z-index: 1;
    padding: 8px 12px;
    font-size: 0.9rem;
    color: var(--texto-2);
    white-space: nowrap;
    transition: color 0.3s;
  }
  .marca__nome { white-space: nowrap; }

  /* Telas médias: menos texto ao redor para os links caberem numa linha só. */
  @media (max-width: 1180px) and (min-width: 901px) {
    .nav__dentro { gap: 12px; }
    .nav__links { gap: 0; }
    .nav__links a { padding: 8px 9px; font-size: 0.86rem; }
    .nav__links a span { display: none; }
    .nav__terminal span, .nav__terminal kbd { display: none; }
  }
  .nav__links a span { font-family: var(--fonte-mono); font-size: 0.72rem; color: var(--suave); margin-right: 6px; transition: color 0.3s; }
  .nav__links a:hover { color: var(--texto); }
  .nav__links a.ativo { color: var(--texto); }
  .nav__links a.ativo span { color: var(--acento); }

  /* Marcador que desliza até o item da seção visível. */
  .nav__indicador {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 0;
    opacity: 0;
    background: var(--acento-fundo);
    border: 1px solid rgba(198, 255, 61, 0.25);
    transition: transform 0.5s var(--ease), width 0.5s var(--ease), opacity 0.3s;
    pointer-events: none;
  }
  .nav__indicador::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: -1px;
    height: 2px;
    background: var(--acento);
    box-shadow: 0 0 12px var(--acento);
  }

  .nav__progresso { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; overflow: hidden; }
  .nav__progresso i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--acento), var(--acento-2));
    transform-origin: left;
    transform: scaleX(0);
  }

  .nav__acoes { display: flex; align-items: center; gap: 10px; }
  .nav__idioma {
    font-family: var(--fonte-mono);
    font-size: 0.8rem;
    padding: 6px 10px;
    border-radius: 8px;
    border: 1px solid var(--linha);
    color: var(--texto-2);
    transition: border-color 0.2s, color 0.2s;
  }
  .nav__idioma:hover { border-color: var(--acento-2); color: var(--acento-2); }
  .nav__terminal kbd { padding: 0 6px; }
  .nav__menu {
    display: none;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid var(--linha);
    background: transparent;
    place-items: center;
  }

  @media (max-width: 900px) {
    .nav__terminal span, .nav__terminal kbd { display: none; }
    .nav__menu { display: grid; }
    .nav__links {
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 8px var(--gutter) 20px;
      background: rgba(4, 6, 9, 0.96);
      border-bottom: 1px solid var(--linha);
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s, transform 0.25s, visibility 0.25s;
    }
    .nav__links a { padding: 14px 0; border-bottom: 1px solid var(--linha); font-size: 1rem; }
    .nav__indicador { display: none; }
    .nav__links a.ativo { color: var(--acento); }
    .nav.aberto .nav__links { opacity: 1; transform: none; visibility: visible; }
    .nav.aberto { background: rgba(4, 6, 9, 0.96); }
  }
  @media (max-width: 420px) {
    .marca__nome { display: none; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const botao = nav.querySelector<HTMLButtonElement>('[data-menu]')!;

  const progresso = nav.querySelector<HTMLElement>('[data-progresso]')!;
  const indicador = nav.querySelector<HTMLElement>('[data-indicador]')!;
  const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-secao]')];

  // Fundo do cabeçalho e barra de progresso da leitura.
  let pendente = false;
  const aoRolar = () => {
    pendente = false;
    nav.classList.toggle('rolou', window.scrollY > 20);
    const total = document.documentElement.scrollHeight - window.innerHeight;
    progresso.style.transform = `scaleX(${total > 0 ? Math.min(1, window.scrollY / total) : 0})`;
  };
  aoRolar();
  window.addEventListener('scroll', () => {
    if (!pendente) {
      pendente = true;
      requestAnimationFrame(aoRolar);
    }
  }, { passive: true });

  // Seção ativa: marca o link e move o indicador até ele.
  function marcar(id: string | null) {
    const ativo = links.find((l) => l.dataset.secao === id);
    links.forEach((l) => {
      l.classList.toggle('ativo', l === ativo);
      if (l === ativo) l.setAttribute('aria-current', 'location');
      else l.removeAttribute('aria-current');
    });
    if (ativo) {
      indicador.style.opacity = '1';
      indicador.style.width = `${ativo.offsetWidth}px`;
      indicador.style.transform = `translateX(${ativo.offsetLeft}px)`;
    } else {
      indicador.style.opacity = '0';
    }
  }

  const secoes = links.map((l) => document.getElementById(l.dataset.secao!)).filter(Boolean) as HTMLElement[];
  if (secoes.length) {
    const visiveis = new Map<string, number>();
    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => visiveis.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0));
        // A seção que mais ocupa a faixa central da tela vence.
        let melhor: string | null = null;
        let maior = 0;
        visiveis.forEach((razao, id) => {
          if (razao > maior) {
            maior = razao;
            melhor = id;
          }
        });
        marcar(melhor);
      },
      { rootMargin: '-35% 0px -45% 0px', threshold: [0, 0.1, 0.25, 0.5, 0.75, 1] },
    );
    secoes.forEach((s) => observador.observe(s));
    window.addEventListener('resize', () => marcar(links.find((l) => l.classList.contains('ativo'))?.dataset.secao ?? null));
  }

  function fecharMenu() {
    nav.classList.remove('aberto');
    botao.setAttribute('aria-expanded', 'false');
  }
  botao.addEventListener('click', () => {
    const aberto = nav.classList.toggle('aberto');
    botao.setAttribute('aria-expanded', String(aberto));
  });
  nav.querySelectorAll('.nav__links a').forEach((a) => a.addEventListener('click', fecharMenu));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && fecharMenu());
</script>
