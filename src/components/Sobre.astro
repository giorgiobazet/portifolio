---
import Cabecalho from './Cabecalho.astro';
import { textos, type Idioma } from '../i18n/textos';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const t = textos[lang].sobre;
---

<section class="secao secao--brilho-ouro" id="sobre" aria-labelledby="sobre-titulo">
  <div class="container">
    <Cabecalho id="sobre-titulo" numero={t.numero} rotulo={t.titulo} frase1={t.frase1} frase2={t.frase2} />

    <div class="sobre__grade">
      <figure class="sobre__foto hud" data-revelar>
        <img src="/img/giorgio.webp" alt={t.foto} width="640" height="800" loading="lazy" decoding="async" />
        <figcaption class="mono"><span>GIORGIO BAZET</span><span>RJ · BR</span></figcaption>
      </figure>

      <div class="sobre__texto">
        {t.bio.map((p, i) => <p data-revelar style={`--atraso:${i}`}>{p}</p>)}

        <dl class="numeros" data-revelar style="--atraso:2">
          {
            t.numeros.map((n) => (
              <div class="numero">
                <dt>{n.rotulo}</dt>
                <dd>{n.valor}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .sobre__grade {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(36px, 6vw, 88px);
    align-items: start;
  }
  .sobre__foto { --corte: 18px; margin: 0; padding: 10px; }
  .sobre__foto img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; filter: saturate(0.9); }
  .sobre__foto figcaption {
    display: flex;
    justify-content: space-between;
    padding: 12px 6px 4px;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    color: var(--suave);
  }
  .sobre__foto figcaption span:last-child { color: var(--acento); }

  .sobre__texto { display: grid; gap: 20px; color: var(--texto-2); font-size: 1.04rem; line-height: 1.75; }
  .sobre__texto > p:first-child { color: var(--texto); font-size: 1.22rem; line-height: 1.6; }

  .numeros {
    margin: 16px 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--linha);
    background: rgba(12, 16, 23, 0.6);
  }
  .numero { padding: 20px 18px; display: flex; flex-direction: column-reverse; gap: 8px; }
  .numero + .numero { border-left: 1px solid var(--linha); }
  .numero dd { margin: 0; font-family: var(--fonte-titulo); font-size: 1.8rem; font-weight: 500; color: var(--texto); line-height: 1; letter-spacing: -0.04em; }
  .numero:first-child dd { color: var(--acento); }
  .numero dt { font-family: var(--fonte-mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--suave); line-height: 1.45; }

  @media (max-width: 960px) {
    .sobre__grade { grid-template-columns: 1fr; }
    .sobre__foto { max-width: 300px; }
  }
  @media (max-width: 640px) {
    .numeros { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .numero:nth-child(3) { border-left: 0; }
    .numero:nth-child(n + 3) { border-top: 1px solid var(--linha); }
  }
</style>
