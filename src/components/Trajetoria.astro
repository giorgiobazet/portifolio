---
import Cabecalho from './Cabecalho.astro';
import { textos, type Idioma } from '../i18n/textos';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const t = textos[lang].trajetoria;
---

<section class="secao secao--brilho-ouro" id="trajetoria" aria-labelledby="trajetoria-titulo">
  <div class="container">
    <Cabecalho id="trajetoria-titulo" numero={t.numero} rotulo={t.titulo} frase1={t.frase1} frase2={t.frase2} />

    <ol class="linha-tempo">
      {
        t.itens.map((item, i) => (
          <li class="marco" data-revelar style={`--atraso:${i % 3}`}>
            <span class="marco__quando mono">{item.quando}</span>
            <span class="marco__ponto" aria-hidden="true" />
            <div class="marco__corpo">
              <span class="marco__tipo mono">{item.tipo}</span>
              <h3>{item.titulo}</h3>
              <p>{item.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .linha-tempo {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    display: grid;
    gap: 14px;
  }
  .linha-tempo::before {
    content: '';
    position: absolute;
    left: 150px;
    top: 14px;
    bottom: 14px;
    width: 1px;
    background: linear-gradient(var(--acento-2), var(--acento) 30%, var(--linha) 75%, transparent);
  }
  .marco {
    display: grid;
    grid-template-columns: 130px 40px minmax(0, 1fr);
    align-items: start;
  }
  .marco__quando { font-size: 0.78rem; color: var(--suave); padding-top: 26px; text-align: right; letter-spacing: 0.06em; }
  .marco__ponto {
    justify-self: center;
    margin-top: 29px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--acento);
  }
  .marco:first-child .marco__ponto { background: var(--acento-2); border-color: var(--acento-2); box-shadow: 0 0 0 5px var(--acento-2-fundo); }
  .marco:first-child .marco__quando { color: var(--acento-2); }

  .marco__corpo {
    margin-left: 14px;
    padding: 20px 24px 22px;
    border-radius: var(--raio);
    border: 1px solid var(--linha);
    background: linear-gradient(180deg, rgba(18, 24, 36, 0.5), rgba(10, 13, 20, 0.35));
    transition: border-color 0.3s, transform 0.4s var(--ease);
  }
  .marco:hover .marco__corpo { border-color: rgba(198, 255, 61, 0.3); transform: translateX(4px); }
  .marco__tipo {
    display: inline-block;
    margin-bottom: 10px;
    padding: 3px 10px;
    border-radius: 3px;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--acento);
    background: var(--acento-fundo);
  }
  .marco:first-child .marco__tipo { color: var(--acento-2); background: var(--acento-2-fundo); }
  .marco__corpo h3 { font-size: 1.12rem; font-weight: 500; letter-spacing: -0.015em; }
  .marco__corpo p { margin-top: 8px; color: var(--texto-2); font-size: 0.93rem; max-width: 64ch; }

  @media (max-width: 640px) {
    .linha-tempo::before { left: 5px; }
    .marco { grid-template-columns: 24px minmax(0, 1fr); row-gap: 6px; }
    .marco__quando { grid-column: 2; grid-row: 1; text-align: left; padding: 0 0 0 14px; }
    .marco__ponto { grid-column: 1; grid-row: 1; justify-self: start; margin-top: 4px; }
    .marco__corpo { grid-column: 2; }
  }
</style>
